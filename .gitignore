.venv/
__pycache__/
.pytest_cache/
*.pyc
*.egg-info/
.DS_Store
*.log

# training runs: weights and prediction dumps stay local; keep configs, metrics and reports
runs/*
!runs/.gitkeep
!runs/*/
runs/*/*
!runs/*/training_config.json
!runs/*/training_metrics.json
!runs/*/report.json
!runs/*/results.jsonl

# the decision-v7 training partition is fetched from the Hub mirror and sha256-checked on first use
evals/v7/decision-v7/train.jsonl
.claude/
!runs/*/*/
runs/*/*/*
!runs/*/*/report.json
evals/public-pool-2k/train.jsonl
evals/v8-data/train.jsonl
# generated data files are rebuilt by scripts/build_*.py; manifests with sha256 stay tracked
evals/delta-v2/train.jsonl
evals/dates-v2/*.jsonl
evals/delta-v3/
evals/v8-data/train.jsonl
runs/e4b-pilot*/
runs/sweep/
runs/mini-*/
runs/smoke*/
runs/headonly-*/
runs/e4b-v7-attempt1-crashed/
runs/logs/
